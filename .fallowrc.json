{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}",
    "testUtils/setup.ts"
  ],
  "ignoreDependencies": [
    "@emotion/react",
    "@emotion/styled",
    "@tanstack/router-core",
    "@vitest/coverage-v8",
    "@vitest/ui",
    "babel-plugin-react-compiler",
    "jiti",
    "typescript-7"
  ],
  "ignorePatterns": [
    "**/*.gen.ts"
  ],
  "rules": {
    "unused-dependencies": "warn"
  }
}
