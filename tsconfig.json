{
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".agents/scripts/**/*.ts",
    ".agents/cli/**/*.ts"
  ],
  "compilerOptions": {
    "target": "es2024",
    "jsx": "react-jsx",
    "module": "esnext",
    "paths": {
      "#common/*": [
        "./src/common/*"
      ],
      "#data/*": [
        "./src/data/*"
      ],
      "#rules/*": [
        "./src/rules/*"
      ],
      "#state/*": [
        "./src/state/*"
      ],
      "#ui/*": [
        "./src/ui/*"
      ],
      "#forms/*": [
        "./src/forms/*"
      ],
      "#app/*": [
        "./src/app/*"
      ],
      "#/*": [
        "./src/*"
      ],
      "#testUtils/*": [
        "./testUtils/*"
      ]
    },
    "lib": [
      "ESNEXT",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "allowSyntheticDefaultImports": true
  }
}
