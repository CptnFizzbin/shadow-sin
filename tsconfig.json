{
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "compilerOptions": {
    "target": "es2024",
    "jsx": "react-jsx",
    "module": "esNExt",
    "paths": {
      "#/*": [
        "./src/*",
        "./src/integrations/*",
        "./lib/*",
        "./src/lib/*",
        "./migrations/*"
      ],
      "#testUtils/*": [
        "./testUtils/*"
      ]
    },
    "lib": [
      "ESNEXT",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "allowSyntheticDefaultImports": true
  }
}
