{
  "$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "src/**/*",
      ".vscode/**/*",
      "index.html",
      "vite.config.ts",
      "biome.json",
      "!src/routeTree.gen.ts",
      "!src/styles.css",
      "imported-shadow-sin-6e"
    ]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noChildrenProp": "off",
        "useImportExtensions": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "bracketSameLine": false,
      "arrowParentheses": "always",
      "trailingNewline": true,
      "semicolons": "asNeeded"
    }
  }
}
